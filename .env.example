# Copiá este archivo a .env (nunca subas .env al repositorio).

# --- Django ---
DEBUG=True
# En producción es obligatoria (generá una con: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# --- Base de datos ---
# Sin esta variable se usa SQLite local (db.sqlite3). En producción usá PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@host:5432/helpdesk

# --- Asistente de IA ---
# none      -> sin costo: responde mostrando el fragmento más relevante de la base de conocimiento
# anthropic -> API de Anthropic
# openai    -> cualquier API compatible con /chat/completions (OpenAI, Groq, OpenRouter, Gemini, ...)
LLM_PROVIDER=none
# LLM_API_KEY=
# Nombre del modelo según tu proveedor (ej. un modelo chico y barato, como un Haiku, para soporte)
# LLM_MODEL=
# Solo para provider "openai" con otro proveedor: LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=500
# Tope diario de consultas con LLM por usuario (protege costos en una demo pública)
ASSISTANT_DAILY_LIMIT=100
# Umbral de abstención (puntaje BM25). Recalibralo con: python manage.py eval_rag --sweep
ASSISTANT_MIN_SCORE=2.5

# --- Restablecimiento de contraseña ---
# En desarrollo, por defecto el enlace se imprime en la consola del servidor.
# En producción configurá SMTP (EMAIL_BACKEND, EMAIL_HOST, EMAIL_HOST_USER/PASSWORD,
# EMAIL_PORT, EMAIL_USE_TLS y DEFAULT_FROM_EMAIL) para que se entregue por correo.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Whodesk <no-reply@example.com>

# --- Producción ---
# SEED_DEMO=1            # carga datos de demostración al arrancar el contenedor (solo si la base está vacía)
# COOKIE_SECURE=False    # únicamente para probar por http en local con DEBUG=False
# SECURE_SSL_REDIRECT=False
